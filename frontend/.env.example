# Base path for REST API calls. Kept relative so Vite's dev proxy (see vite.config.ts)
# intercepts it and forwards to the backend on http://localhost:3000, avoiding CORS in development
# (the backend's REST API has no CORS middleware configured).
VITE_API_BASE_URL=/api/v1

# Origin the Socket.IO client connects to. The backend's Socket.IO layer has its own CORS
# handling (SOCKET_CORS_ORIGIN env var on the backend), so this can be an absolute URL.
VITE_SOCKET_URL=http://localhost:3000
